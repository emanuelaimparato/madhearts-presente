# Ambiente Python (va creato su ogni Mac con installa.sh)
.venv/
__pycache__/
*.pyc

# Modelli MediaPipe (scaricati da installa.sh / tools.download_models)
models/*.task
models/*.part

# Dati locali di ogni installazione: regolazioni del Mac, sfera e impostazioni del pannello
config.local.toml
data/sfera*.json
data/impostazioni.json
logs/

# App creata su ogni Mac da installa_app.sh
MadHearts.app/

# Musica: file pesanti e con diritti — si condividono a parte
audio/*.mp3
audio/*.wav
audio/*.ogg
audio/*.m4a
web/audio/*.mp3
web/audio/*.wav
web/audio/*.ogg
web/audio/*.m4a

# macOS
.DS_Store
